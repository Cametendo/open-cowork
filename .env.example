# Copy to .env and adjust. Used by docker compose and ./start.sh.

# Port Open Cowork runs on (Docker and ./start.sh). Open WebUI keeps its default 3000.
OPEN_COWORK_PORT=3001

# Initial model connections. Only applied on first boot; manage them later in Admin > Connections.
# Ollama on this machine. With docker-compose.bridge.yml (Docker Desktop) use http://host.docker.internal:11434
OLLAMA_BASE_URL=http://localhost:11434
# e.g. https://api.openai.com/v1, http://localhost:1234/v1 (LM Studio), http://localhost:8000/v1 (vLLM)
OPENAI_API_BASE_URL=
OPENAI_API_KEY=

# Session signing / secret encryption key. Empty = generated once and stored in the data dir.
WEBUI_SECRET_KEY=

WEBUI_NAME=Open Cowork
# First boot only; change later in Admin > General
ENABLE_SIGNUP=true
# pending | user
DEFAULT_USER_ROLE=pending
# First boot only; change later in Admin > Cowork & GitHub
COWORK_ALLOW_SHELL=true
